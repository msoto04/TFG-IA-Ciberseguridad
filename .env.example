# Configuración de Rutas
UPLOAD_DIR=/app/uploads
EXTRACT_DIR=/app/auditoria_temp
FAISS_PATH=/app/faiss_index

# Configuración de IA — Modo Local (Ollama)
OLLAMA_URL=http://host.docker.internal:11434
MODELO_ORQUESTADOR=deepseek-r1:8b

# Configuración de IA — Modo API (Groq)
# Necesario solo si se usa MODO_INFERENCIA=api
# Obtén tu clave en https://console.groq.com/keys
GROQ_API_KEY=gsk_tuclaveaquí

# Modo de inferencia: "local" (Ollama) o "api" (Groq)
MODO_INFERENCIA=local

# Configuración de Infraestructura
REDIS_URL=redis://redis:6379/0

# Seguridad y Autenticación
SECRET_KEY=cambia_esto_por_una_clave_secreta_segura